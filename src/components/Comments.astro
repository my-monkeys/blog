---
// Commentaires — servis par l'API du blog (`api/`), deux façons d'être propriétaire :
// 1. Anonyme : un `session_token` (uuid) gardé en localStorage et envoyé en en-tête
// 2. Compte : session Better Auth (Google), cookie posé par l'API
// Le droit de modifier n'est plus déduit ici : le serveur renvoie `can_edit` par commentaire.
---

<section class="comments" aria-label="Commentaires">
  <div class="comments-header">
    <h2 class="section-heading">Commentaires</h2>
    <div class="comment-auth" data-comment-auth hidden>
      <button type="button" class="comment-login-btn" data-login-btn hidden>Se connecter</button>
      <div class="comment-user" data-comment-user hidden>
        <span class="comment-user-name" data-user-name></span>
        <button type="button" class="comment-logout-btn" data-logout-btn>Déconnexion</button>
      </div>
    </div>
  </div>

  <div class="comment-form-card">
    <form class="comment-form" data-comment-form>
      <input
        type="text"
        name="author_name"
        placeholder="Ton nom"
        required
        maxlength="80"
        autocomplete="name"
        class="comment-input"
      />
      <textarea
        name="message"
        placeholder="Ton commentaire…"
        required
        maxlength="2000"
        rows="3"
        class="comment-textarea"
      ></textarea>
      <div class="comment-form-footer">
        <span class="comment-error" data-comment-error></span>
        <button type="submit" class="comment-submit">Envoyer</button>
      </div>
    </form>
  </div>

  <div class="comment-list" data-comment-list>
    <p class="comment-loading">Chargement…</p>
  </div>

  <dialog class="login-dialog" data-login-dialog aria-labelledby="login-dialog-titre">
    <h2 class="login-dialog-titre" id="login-dialog-titre">Se connecter</h2>
    <p class="login-dialog-corps">
      Tu peux commenter sans compte : ton navigateur retient le tien pour te laisser le corriger
      ensuite. Avec un compte, ton nom te suit d'un appareil à l'autre et tes commentaires
      portent une petite coche.
    </p>
    <p class="login-dialog-note">Tu vas être redirigé vers Google, puis ramené à cet article.</p>
    <div class="login-dialog-actions">
      <button type="button" class="comment-submit" data-login-google>Continuer avec Google</button>
      <button type="button" class="comment-cancel-btn" data-login-cancel>Annuler</button>
    </div>
  </dialog>
</section>

<script>
  import { createAuthClient } from 'better-auth/client';

  // Surchargeable en dev (`PUBLIC_COMMENTS_API=http://localhost:3000`) ; en production l'URL
  // est stable et publique, elle n'a pas besoin de traverser la configuration de Coolify.
  const API = import.meta.env.PUBLIC_COMMENTS_API ?? 'https://blog-api.my-monkey.fr';
  const TOKEN_KEY = 'blog_comment_token';
  const NAME_KEY = 'blog_comment_name';

  const authClient = createAuthClient({ baseURL: API });

  // Le cookie de session vit sur le sous-domaine de l'API : `credentials: 'include'` est ce qui
  // le fait voyager, `blog.` et `blog-api.` étant sur le même site aux yeux du navigateur.
  async function appelAPI(chemin: string, options: RequestInit = {}) {
    return fetch(`${API}${chemin}`, {
      ...options,
      credentials: 'include',
      headers: {
        'x-session-token': getSessionToken(),
        ...(options.body ? { 'content-type': 'application/json' } : {}),
        ...options.headers,
      },
    });
  }

  function getSlug() {
    return window.location.pathname.replace(/\/+$/, '').split('/').pop() || '';
  }

  function getSessionToken(): string {
    let token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      token = crypto.randomUUID();
      localStorage.setItem(TOKEN_KEY, token);
    }
    return token;
  }

  function escapeHTML(s: string) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function timeAgo(dateStr: string) {
    const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
    if (diff < 60) return "à l'instant";
    if (diff < 3600) return Math.floor(diff / 60) + ' min';
    if (diff < 86400) return Math.floor(diff / 3600) + ' h';
    if (diff < 2592000) return Math.floor(diff / 86400) + ' j';
    return new Date(dateStr).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  interface Comment {
    id: string;
    author_name: string;
    message: string;
    created_at: string;
    verified: boolean;
    can_edit: boolean;
  }

  let currentUser: { id: string; name: string } | null = null;

  function renderComments(comments: Comment[], listEl: HTMLElement) {
    if (!comments.length) {
      listEl.innerHTML = '<p class="comment-empty">Aucun commentaire. Sois le premier.</p>';
      return;
    }
    listEl.innerHTML = comments.map((c) =>
      `<div class="comment" data-id="${c.id}">
        <div class="comment-header">
          <span class="comment-author">${escapeHTML(c.author_name)}${c.verified ? ' <span class="comment-verified" title="Compte vérifié">✓</span>' : ''}</span>
          <span class="comment-date">${timeAgo(c.created_at)}</span>
          ${c.can_edit ? `<div class="comment-actions">
            <button type="button" class="comment-action-btn" data-edit="${c.id}" title="Modifier">✎</button>
            <button type="button" class="comment-action-btn comment-action-delete" data-delete="${c.id}" title="Supprimer">✕</button>
          </div>` : ''}
        </div>
        <p class="comment-body">${escapeHTML(c.message)}</p>
      </div>`
    ).join('');

    for (const btn of listEl.querySelectorAll<HTMLButtonElement>('[data-edit]')) {
      btn.addEventListener('click', () => startEdit(btn.dataset.edit!, comments));
    }
    for (const btn of listEl.querySelectorAll<HTMLButtonElement>('[data-delete]')) {
      btn.addEventListener('click', () => deleteComment(btn.dataset.delete!));
    }
  }

  function startEdit(id: string, comments: Comment[]) {
    const c = comments.find((x) => x.id === id);
    if (!c) return;
    const el = document.querySelector<HTMLElement>(`.comment[data-id="${id}"]`);
    if (!el) return;
    const body = el.querySelector('.comment-body')!;
    body.innerHTML = `
      <textarea class="comment-edit-textarea" maxlength="2000"></textarea>
      <div class="comment-edit-actions">
        <button type="button" class="comment-submit comment-save-btn" data-save="${id}">Sauver</button>
        <button type="button" class="comment-cancel-btn" data-cancel="${id}">Annuler</button>
      </div>
    `;
    const textarea = body.querySelector('textarea')!;
    textarea.value = c.message;
    textarea.focus();
    body.querySelector<HTMLButtonElement>('[data-save]')!.addEventListener('click', () => saveEdit(id, textarea.value));
    body.querySelector<HTMLButtonElement>('[data-cancel]')!.addEventListener('click', () => loadComments());
  }

  async function saveEdit(id: string, message: string) {
    const trimmed = message.trim();
    if (!trimmed) return;
    const res = await appelAPI(`/comments/${id}`, {
      method: 'PATCH',
      body: JSON.stringify({ message: trimmed }),
    });
    if (!res.ok) console.error('modification refusée:', res.status);
    loadComments();
  }

  async function deleteComment(id: string) {
    if (!confirm('Supprimer ce commentaire ?')) return;
    const res = await appelAPI(`/comments/${id}`, { method: 'DELETE' });
    if (!res.ok) console.error('suppression refusée:', res.status);
    loadComments();
  }

  async function loadComments() {
    const listEl = document.querySelector<HTMLElement>('[data-comment-list]');
    if (!listEl) return;
    try {
      const res = await appelAPI(`/comments?slug=${encodeURIComponent(getSlug())}`);
      if (!res.ok) throw new Error(String(res.status));
      renderComments((await res.json()) as Comment[], listEl);
    } catch {
      listEl.innerHTML = '<p class="comment-empty">Impossible de charger les commentaires.</p>';
    }
  }

  // Tant qu'aucun client OAuth n'est déclaré côté API, proposer « Se connecter » mènerait à une
  // erreur : le bouton reste caché, et réapparaît de lui-même dès que l'API l'annonce.
  async function loginDisponible(): Promise<boolean> {
    try {
      const res = await appelAPI('/config');
      return res.ok && (await res.json()).login === true;
    } catch {
      return false;
    }
  }

  async function updateAuthUI() {
    const authContainer = document.querySelector<HTMLElement>('[data-comment-auth]');
    const loginBtn = document.querySelector<HTMLElement>('[data-login-btn]');
    const userEl = document.querySelector<HTMLElement>('[data-comment-user]');
    const nameInput = document.querySelector<HTMLInputElement>('[name="author_name"]');
    const nameEl = document.querySelector<HTMLElement>('[data-user-name]');

    // L'API peut être injoignable : on rend alors la section telle qu'elle est pour un visiteur
    // sans compte, plutôt que d'interrompre l'initialisation du reste du composant.
    const [session, connexionDisponible] = await Promise.all([
      authClient.getSession().catch(() => null),
      loginDisponible(),
    ]);
    const user = session?.data?.user;

    if (user) {
      const name = user.name || user.email || 'Utilisateur';
      currentUser = { id: user.id, name };
      if (loginBtn) loginBtn.hidden = true;
      if (userEl) userEl.hidden = false;
      if (nameInput) { nameInput.value = name; nameInput.readOnly = true; }
      if (nameEl) nameEl.textContent = name;
    } else {
      currentUser = null;
      if (loginBtn) loginBtn.hidden = !connexionDisponible;
      if (userEl) userEl.hidden = true;
      if (nameInput) {
        nameInput.readOnly = false;
        const saved = localStorage.getItem(NAME_KEY);
        if (saved) nameInput.value = saved;
      }
    }

    if (authContainer) authContainer.hidden = false;
  }

  function attachForm() {
    const form = document.querySelector<HTMLFormElement>('[data-comment-form]');
    if (!form || form.dataset.attached === '1') return;
    form.dataset.attached = '1';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorEl = form.querySelector<HTMLElement>('[data-comment-error]')!;
      const btn = form.querySelector<HTMLButtonElement>('.comment-submit')!;
      const nameInput = form.querySelector<HTMLInputElement>('[name="author_name"]')!;
      const msgInput = form.querySelector<HTMLTextAreaElement>('[name="message"]')!;
      const name = nameInput.value.trim();
      const msg = msgInput.value.trim();
      if (!name || !msg) return;

      btn.disabled = true;
      btn.textContent = '…';
      errorEl.textContent = '';

      if (!currentUser) localStorage.setItem(NAME_KEY, name);

      const res = await appelAPI('/comments', {
        method: 'POST',
        body: JSON.stringify({ post_slug: getSlug(), author_name: name, message: msg }),
      });
      if (res.ok) {
        msgInput.value = '';
        loadComments();
      } else {
        const { error } = await res.json().catch(() => ({ error: '' }));
        errorEl.textContent = 'Erreur : ' + (error || 'réessaie.');
      }
      btn.disabled = false;
      btn.textContent = 'Envoyer';
    });
  }

  function attachAuth() {
    const loginBtn = document.querySelector<HTMLButtonElement>('[data-login-btn]');
    const logoutBtn = document.querySelector<HTMLButtonElement>('[data-logout-btn]');

    const dialogue = document.querySelector<HTMLDialogElement>('[data-login-dialog]');

    // Partir chez Google au clic serait brutal au milieu d'un article : on explique d'abord ce
    // que le compte apporte, et qu'on va sortir du site.
    loginBtn?.addEventListener('click', () => dialogue?.showModal());
    dialogue?.querySelector('[data-login-cancel]')?.addEventListener('click', () => dialogue.close());

    // `showModal` place le fond dans le ::backdrop : un clic dessus atteint le <dialog> lui-même,
    // jamais son contenu, ce qui suffit à distinguer les deux.
    dialogue?.addEventListener('click', (e) => {
      if (e.target === dialogue) dialogue.close();
    });

    dialogue?.querySelector('[data-login-google]')?.addEventListener('click', () => {
      // Google renvoie sur l'API, qui repose ensuite le visiteur sur l'article qu'il lisait.
      authClient.signIn.social({ provider: 'google', callbackURL: window.location.href });
    });

    logoutBtn?.addEventListener('click', async () => {
      await authClient.signOut();
      await updateAuthUI();
      loadComments();
    });
  }

  async function init() {
    // Les gestionnaires d'abord : ils ne dépendent que du DOM. Les poser après les appels réseau
    // laissait la modale et le formulaire inertes dès que l'API tardait ou refusait de répondre.
    attachForm();
    attachAuth();
    await updateAuthUI();
    loadComments();
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .comments {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid var(--ink);
  }

  .comments-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .comments .section-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Auth row */
  .comment-auth {
    align-items: center;
    gap: 0.75rem;
  }
  .comment-auth:not([hidden]) { display: flex; }
  .comment-login-btn {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border: 2px solid var(--ink);
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .comment-login-btn:hover {
    background: var(--ink);
    color: var(--bg);
  }
  .comment-user {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    align-items: center;
    gap: 0.5rem;
  }
  .comment-user:not([hidden]) { display: flex; }
  .comment-user-name { font-weight: 600; }
  .comment-logout-btn {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    opacity: 0.7;
    transition: opacity 0.15s;
  }
  .comment-logout-btn:hover { opacity: 1; }

  /* Form card */
  .comment-form-card {
    border: 2px solid var(--ink);
    background: var(--bg-elev);
    padding: 1.25rem;
    margin-bottom: 2rem;
  }
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .comment-input,
  .comment-textarea,
  .comment-edit-textarea {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    padding: 0.6rem 0.75rem;
    border: 2px solid color-mix(in srgb, var(--ink) 40%, transparent);
    background: var(--bg);
    color: var(--ink);
    width: 100%;
    resize: vertical;
    transition: border-color 0.15s;
  }
  .comment-input:hover,
  .comment-textarea:hover { border-color: var(--ink); }
  .comment-input[readonly] {
    background: var(--bg-elev);
    color: var(--ink-soft);
    border-style: dashed;
    cursor: not-allowed;
  }
  .comment-input::placeholder,
  .comment-textarea::placeholder {
    color: var(--ink-soft);
    opacity: 0.5;
  }
  .comment-input:focus,
  .comment-textarea:focus,
  .comment-edit-textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .comment-edit-textarea {
    margin-bottom: 0.5rem;
    min-height: 4rem;
  }
  .comment-form-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
  }
  .comment-error {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--alert);
    margin-right: auto;
  }
  .comment-submit {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 1.5rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--bg);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }
  .comment-submit:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .comment-submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    box-shadow: none;
  }

  /* Modale de connexion — mêmes bords francs et même ombre dure que la lightbox */
  .login-dialog {
    /* Le centrage par défaut d'un <dialog> ne survit pas à une largeur contrainte : sans ce
       inset + margin auto, la boîte se colle en haut à gauche. Même recette que la lightbox. */
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(92vw, 30rem);
    height: fit-content;
    max-height: 90vh;
    overflow: auto;
    padding: 2rem;
    border: 3px solid var(--ink);
    background: var(--bg);
    color: var(--ink);
    box-shadow: var(--shadow-hard);
  }
  .login-dialog::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }
  .login-dialog-titre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }
  .login-dialog-corps {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
  .login-dialog-note {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    margin: 0 0 1.75rem;
  }
  .login-dialog-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .comment-edit-actions {
    display: flex;
    gap: 0.5rem;
  }
  .comment-cancel-btn {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    border: 2px solid color-mix(in srgb, var(--ink) 40%, transparent);
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }
  .comment-cancel-btn:hover { border-color: var(--ink); }

  /* Comment list — :global because items are injected via innerHTML */
  :global(.comment-list) {
    display: flex;
    flex-direction: column;
  }
  :global(.comment-loading),
  :global(.comment-empty) {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  :global(.comment) {
    padding: 1.25rem;
    border: 2px solid color-mix(in srgb, var(--ink) 20%, transparent);
    background: var(--bg-elev);
    margin-bottom: 0.75rem;
    transition: border-color 0.15s;
  }
  :global(.comment:hover) { border-color: color-mix(in srgb, var(--ink) 40%, transparent); }
  :global(.comment:last-child) { margin-bottom: 0; }
  :global(.comment-header) {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  :global(.comment-author) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }
  :global(.comment-verified) {
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  :global(.comment-date) {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  :global(.comment-actions) {
    margin-left: auto;
    display: flex;
    gap: 0.35rem;
  }
  :global(.comment-action-btn) {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border: 2px solid color-mix(in srgb, var(--ink) 20%, transparent);
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    line-height: 1;
    transition: all 0.15s;
  }
  :global(.comment-action-btn:hover) {
    color: var(--ink);
    border-color: var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
  }
  :global(.comment-action-delete:hover) {
    color: var(--alert);
    border-color: var(--alert);
    box-shadow: 2px 2px 0 var(--alert);
  }
  :global(.comment-body) {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
